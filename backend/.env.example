# Backend Environment Variables
# Copy to .env and fill in your values — NEVER commit .env to version control

# Server
NODE_ENV=development
PORT=5013
API_VERSION=v1

# MongoDB (Internal loopback port 27029)
MONGODB_URI=mongodb://127.0.0.1:27029/athiran_crm

# JWT
JWT_ACCESS_SECRET=your_access_token_secret_min_64_chars_here
JWT_REFRESH_SECRET=your_refresh_token_secret_min_64_chars_different_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies (set to true in production with HTTPS)
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict

# Admin seed account (used by seedAdmin.js only)
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@athiranmotors.com
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=ChangeMe@2024!

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:98

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# File uploads
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads

# Timezone
TZ=Asia/Kolkata

# Logging
LOG_LEVEL=debug
LOG_FILE=src/logs/app.log

