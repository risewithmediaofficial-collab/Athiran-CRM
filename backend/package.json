{
  "name": "athiran-crm-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Athiran Motors CRM — Node.js + Express + MongoDB API Server",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node scripts/seedAdmin.js",
    "seed:roles": "node scripts/seedRoles.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/integration --runInBand",
    "test:security": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/security --runInBand"
  },
  "dependencies": {
    "express": "^4.21.1",
    "mongoose": "^8.8.3",
    "argon2": "^0.41.1",
    "jsonwebtoken": "^9.0.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "cors": "^2.8.5",
    "express-validator": "^7.2.0",
    "winston": "^3.17.0",
    "node-cron": "^3.0.3",
    "socket.io": "^4.8.1",
    "multer": "^1.4.5-lts.1",
    "dotenv": "^16.4.7",
    "morgan": "^1.10.0",
    "cookie-parser": "^1.4.7",
    "uuid": "^11.0.3",
    "dayjs": "^1.11.13"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "@jest/globals": "^29.7.0",
    "eslint": "^9.15.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {}
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

